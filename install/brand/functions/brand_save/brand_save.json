{
  "name": "brand_save",
  "description": "Keep what a read found about a brand: colours by role (with what each is for and where it was found), faces, voice, the guide (markdown), logos (asset ids and variants), evidence, radius. Measures contrast, keeps a person's fixes, writes theme.css and theme.json, and asks a person to check the brand.",
  "type": "API",
  "visibility": "POD",
  "code": {
    "$file": "code.py"
  },
