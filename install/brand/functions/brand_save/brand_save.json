    "grants": [
      {
        "resource_type": "datastore_table",
        "resource_name": "brand",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read",
          "datastore.record.write"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "brand_asset",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read",
          "datastore.record.write"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "brand_evidence",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read",
          "datastore.record.write",
          "datastore.record.delete"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "brand_job",
        "permission_ids": [
