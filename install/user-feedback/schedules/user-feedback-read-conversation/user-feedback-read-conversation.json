  "config": { "table_name": "conversation", "operations": ["UPDATE"],
              "when": { "kind": "people", "sorted_at": { "changed": true } }, "bulk_writes": "each" },
  "workflow_name": "user-feedback-read-conversation",
  "is_active": true
}
