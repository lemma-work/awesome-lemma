{
  "name": "release_notes_on_merge",
  "description": "A pull request closed on GitHub. When it merged into a watched repository: keeps it with its kind (Decisions: feature, improvement, fix, breaking, routine, internal) and the issues it closes, writes an ask for each issue author and 'me too' commenter, and hangs it on the open note. Answers skip otherwise.",
  "type": "API",
  "visibility": "POD",
  "code": {
    "$file": "code.py"
  },
  "permissions": {
    "grants": [
      {
        "resource_type": "datastore_table",
        "resource_name": "release_note_settings",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "release_note",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read",
          "datastore.record.write"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "release_note_pr",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read",
          "datastore.record.write"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "ask",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read",
          "datastore.record.write"
        ]
      },
      {
        "resource_type": "connector",
        "resource_name": "github",
        "permission_ids": [
          "connector.use"
        ]
      }
    ]
  }
}
