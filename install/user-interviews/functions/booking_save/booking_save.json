{
  "name": "booking_save",
  "description": "Keep the person's booking settings and their page (address, name, one line about them, video, where declines are emailed from), from the set-up's forms or the settings screen. The address is checked: its form, words the app keeps, and nobody else's.",
  "type": "API",
  "visibility": "POD",
  "code": {
    "$file": "code.py"
  },
  "permissions": {
    "grants": [
      {
        "resource_type": "datastore_table",
        "resource_name": "booking_settings",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read",
          "datastore.record.write"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "booking_page",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read",
          "datastore.record.write"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "meetings_calendar",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read"
        ]
      },
      {
        "resource_type": "folder",
        "resource_name": "/memory",
        "permission_ids": [
          "folder.read",
          "folder.write"
        ]
      }
    ]
  }
}
