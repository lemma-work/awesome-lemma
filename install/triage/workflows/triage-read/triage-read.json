{
  // triage_reader on one item. Started by triage_read (and by a report that
  // takes an item past 25 people or a high security alert), which submits the
  // brief form at once, so the run never waits on a person: the AGENT step
  // reads, and triage_read_save keeps what it found.
  "name": "triage-read",
  "description": "The Lemma's read of one item: what it is, what each source answered, and what couldn't be checked.",
  "run_title": ["brief.item_id"],
  "start": { "type": "MANUAL" },
  "nodes": [
    { "id": "brief", "type": "FORM", "label": "The item",
      "config": { "input_schema": {
        "type": "object",
        "properties": {
          "item_id": { "type": "string", "title": "Item" },
          "context": { "type": "string", "title": "What to read" }
        },
        "required": ["item_id", "context"]
      } } },
    { "id": "look", "type": "AGENT", "label": "Read it",
      "config": { "agent_name": "triage_reader", "input_mapping": {
        "context": { "type": "expression", "value": "brief.context" } } } },
    { "id": "save", "type": "FUNCTION", "label": "Keep the read",
      "config": { "function_name": "triage_read_save", "input_mapping": {
        "item_id": { "type": "expression", "value": "brief.item_id" },
        "result": { "type": "expression", "value": "look" } } } },
    { "id": "end", "type": "END", "label": "Done" }
  ],
  "edges": [
    { "id": "e1", "source": "brief", "target": "look" },
    { "id": "e2", "source": "look", "target": "save" },
    { "id": "e3", "source": "save", "target": "end" }
  ]
}
