{
  "name": "triage_on_github",
  "description": "A GitHub webhook on a watched repository: issues (opened, reopened, closed; issue forms read field by field), issue_comment (+1 adds an asker), dependabot_alert, code_scanning_alert, secret_scanning_alert (opened files a report; fixed or dismissed closes the item).",
  "type": "API",
  "visibility": "POD",
  "code": {
    "$file": "code.py"
  },
  "permissions": {
    "grants": [
      {
        "resource_type": "datastore_table",
        "resource_name": "triage_settings",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "triage_report",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read",
          "datastore.record.write"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "triage_item",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read",
          "datastore.record.write"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "triage_event",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read",
          "datastore.record.write"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "triage_rule",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "triage_correction",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "ask",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read",
          "datastore.record.write"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "away",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read"
        ]
      },
      {
        "resource_type": "connector",
        "resource_name": "github",
        "permission_ids": [
          "connector.use"
        ]
      },
      {
        "resource_type": "connector",
        "resource_name": "slack",
        "permission_ids": [
          "connector.use"
        ]
      },
      {
        "resource_type": "workflow",
        "resource_name": "triage-read",
        "permission_ids": [
          "workflow.read",
          "workflow.execute"
        ]
      },
      {
        "resource_type": "function",
        "resource_name": "triage_needs_you",
        "permission_ids": [
          "function.execute"
        ]
      }
    ]
  }
