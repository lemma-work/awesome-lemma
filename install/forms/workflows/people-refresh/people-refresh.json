    { "id": "sort", "type": "FUNCTION", "label": "Read anyone new",
      "config": { "function_name": "people_sort", "input_mapping": {
        "max_people": { "type": "literal", "value": 80 } } } },
    { "id": "share", "type": "FUNCTION", "label": "Companies and the team's view",
