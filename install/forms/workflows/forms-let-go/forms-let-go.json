{
  // Each member's own schedule (forms-let-go-<user>), made by the app on their first visit: when owner_user_id changed from them.
  "name": "forms-let-go",
  "description": "An answer this person owned went to someone else: their side is closed.",
  "max_concurrent_runs": 4,
  "start": { "type": "DATASTORE_EVENT", "config": { "table_name": "form_answer", "operations": ["UPDATE"] } },
  "nodes": [
    { "id": "run", "type": "FUNCTION", "label": "Let it go",
      "config": { "function_name": "forms_let_go", "input_mapping": { "record_id": { "type": "expression", "value": "start.metadata.record_id" } } } },
    { "id": "end", "type": "END", "label": "Done" }
  ],
  "edges": [ { "id": "e1", "source": "run", "target": "end" } ]
}
