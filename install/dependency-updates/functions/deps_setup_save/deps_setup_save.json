{
  "name": "deps_setup_save",
  "description": "Dependency updates' set-up: the repositories to watch, the day and time of the weekly batch (default Monday 06:00), the wait (3 days, 14 for a major), and commands a person confirmed. Whoever saves it first is the owner who decides. Writes the memory block. Never makes schedules: the app makes them as the person.",
  "type": "API",
  "visibility": "POD",
  "code": {
    "$file": "code.py"
  },
  "permissions": {
    "grants": [
      {
        "resource_type": "datastore_table",
        "resource_name": "deps_settings",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read",
          "datastore.record.write"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "deps_repo",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read",
          "datastore.record.write"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "needs_you",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read",
          "datastore.record.write"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "deps_update",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read"
        ]
      },
      {
        "resource_type": "function",
        "resource_name": "deps_memory",
        "permission_ids": [
          "function.execute"
        ]
      }
    ]
  }
}
