{
  "name": "prr_intake",
  "description": "A GitHub event or the sync to pull_request rows: risk from the team's risky paths and the size (lockfiles not counted), who wrote it, the issues it closes, and a review round queued when one is due (prr-review). event pull_request, pull_request_review, check_suite (settles pull requests at that commit), sync (a repository's open pull requests) or app (queue yes: Review again). No model.",
  "type": "API",
  "visibility": "POD",
  "code": {
    "$file": "code.py"
  },
