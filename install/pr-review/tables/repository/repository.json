{
  // A GitHub repository the team watches: one row per repository, with how
  // PR review treats it and what GitHub says about it. Facts only: no rule,
  // no finding and no word anyone wrote lives here.
  //
  // Team-wide (no RLS): every member sees every watched repository.
  //
  // Shared definition (plugins/_contract), first written by PR review, and
  // written only by it. Read by Release notes, Dependency updates and Coding
  // agent, which find a repository by `full_name`. A plugin's own state about
  // a repository goes in its own table, keyed by this row's id or naming it
  // by `full_name` (Coding agent: `coding_repo`).
  "name": "repository",
  "primary_key_column": "id",
  "enable_rls": false,
  "visibility": "POD",
  "columns": [
    // owner/name, as GitHub spells it.
    { "name": "full_name", "type": "TEXT", "required": true, "unique": true, "max_length": 200 },
    { "name": "default_branch", "type": "TEXT", "max_length": 255 },
    { "name": "html_url", "type": "TEXT", "max_length": 500 },
    // off: not reviewed. once: the first push of each pull request only.
    // every_push: a round on every push.
    { "name": "review_mode", "type": "ENUM", "required": true, "default": "every_push",
      "options": ["off", "once", "every_push"] },
    // off: a clean pull request waits for a person. watch: records what would
    // have merged and merges nothing. merge: merges small clean ones by itself.
    { "name": "merge_mode", "type": "ENUM", "required": true, "default": "off",
      "options": ["off", "watch", "merge"] },
    // What GitHub said when last read (`checked_at`): "Allow auto-merge" is
    // on, a merge queue guards the default branch, the check branch
    // protection requires by name (the Lemma check, or null), and how many
    // approving reviews it requires. Null when it could not be read.
    { "name": "allow_auto_merge", "type": "BOOLEAN" },
    { "name": "merge_queue", "type": "BOOLEAN" },
    { "name": "required_check", "type": "TEXT", "max_length": 120 },
    { "name": "required_approvals", "type": "INTEGER" },
    { "name": "checked_at", "type": "DATETIME" },
    // Where it came from: github, or sample.
    { "name": "source", "type": "TEXT", "required": true, "default": "github", "max_length": 32 },
    // GitHub's own repository id.
    { "name": "source_id", "type": "TEXT", "max_length": 400 }
  ],
  "config": {}
}
