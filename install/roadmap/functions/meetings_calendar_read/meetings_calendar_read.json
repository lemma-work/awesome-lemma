{
  "name": "meetings_calendar_read",
  "description": "Read Google Calendar, Outlook or the sample calendar: the last month and the next two weeks, into meetings, and everyone on them into the shared people (found by handle, as Mail does). Who is from outside comes from email domains, never a model. Idempotent.",
  "type": "API",
  "visibility": "POD",
  "code": {
    "$file": "code.py"
  },
