{
  "name": "roadmap_set",
  "description": "Put a feature on the roadmap or move it (horizon now, next, later, none), decline it, give it an owner (owner_user_id or owner_label), or set how the outside page shows it (public, public_title, public_blurb). Moves feature.stage forward only: next or later -> planned, now -> building, decline -> declined; never live, never back.",
  "type": "API",
  "visibility": "POD",
  "code": {
    "$file": "code.py"
  },
  "permissions": {
    "grants": [
      {
        "resource_type": "datastore_table",
        "resource_name": "feature",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read",
          "datastore.record.write"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "roadmap_item",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read",
          "datastore.record.write"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "roadmap_public",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read",
          "datastore.record.write",
          "datastore.record.delete"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "roadmap_settings",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "deals_settings",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read"
        ]
      }
    ]
  }
}
