{
  "name": "coding_tick",
  "description": "Every 15 minutes, as each person: their live sessions' conversations (finished, failed, waiting on them), their open pull requests (merged, closed, conflicts, checks), and their items in Today.",
  "type": "API",
  "visibility": "POD",
  "code": {
    "$file": "code.py"
  },
  "permissions": {
    "grants": [
      {
        "resource_type": "datastore_table",
        "resource_name": "coding_settings",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "coding_session",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read",
          "datastore.record.write"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "coding_event",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read",
          "datastore.record.write"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "task",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read",
          "datastore.record.write"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "personal_task",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read",
          "datastore.record.write"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "needs_you",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read",
          "datastore.record.write"
        ]
      },
      {
        "resource_type": "agent",
        "resource_name": "coding_builder",
        "permission_ids": [
          "agent.read",
          "agent.execute"
        ]
      },
      {
        "resource_type": "connector",
        "resource_name": "github",
        "permission_ids": [
          "connector.use"
        ]
      }
    ]
  }
}
