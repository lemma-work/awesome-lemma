{
  // The write-up of one resolved incident. Started by incidents_resolve, which
  // submits the brief form at once: incidents_writer drafts from the events,
  // and incidents_writeup_save reviews it, proposes follow-ups, writes the file
  // and tells the lead.
  "name": "incidents-writeup",
  "description": "Draft a resolved incident's write-up from its events, flag what nothing backs, and give it to the lead to review.",
  "run_title": ["brief.incident_id"],
  "start": { "type": "MANUAL" },
  "nodes": [
    { "id": "brief", "type": "FORM", "label": "The incident",
      "config": { "input_schema": {
        "type": "object",
        "properties": {
          "incident_id": { "type": "string", "title": "Incident" },
          "context": { "type": "string", "title": "What to write from" }
        },
        "required": ["incident_id", "context"]
      } } },
    { "id": "write", "type": "AGENT", "label": "Draft the write-up",
      "config": { "agent_name": "incidents_writer", "input_mapping": {
        "context": { "type": "expression", "value": "brief.context" } } } },
    { "id": "save", "type": "FUNCTION", "label": "Review it, file it, tell the lead",
      "config": { "function_name": "incidents_writeup_save", "input_mapping": {
        "incident_id": { "type": "expression", "value": "brief.incident_id" },
        "result": { "type": "expression", "value": "write" } } } },
    { "id": "end", "type": "END", "label": "Done" }
  ],
  "edges": [
    { "id": "e1", "source": "brief", "target": "write" },
    { "id": "e2", "source": "write", "target": "save" },
    { "id": "e3", "source": "save", "target": "end" }
  ]
}
