{
  "name": "incidents_refresh",
  "description": "Keep an incident's pinned header and channel topic current, and ask incidents_scribe to redraw its Now from the events only (it lands a minute later, through incidents_scribe_save). header_only skips the redraw.",
  "type": "API",
  "visibility": "POD",
  "code": {
    "$file": "code.py"
  },
  "permissions": {
    "grants": [
      {
        "resource_type": "datastore_table",
        "resource_name": "incidents_settings",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "incidents_incident",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read",
          "datastore.record.write"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "incidents_event",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read"
        ]
      },
      {
        "resource_type": "connector",
        "resource_name": "slack",
        "permission_ids": [
          "connector.use"
        ]
      },
      {
        "resource_type": "workflow",
        "resource_name": "incidents-scribe",
        "permission_ids": [
          "workflow.read",
          "workflow.execute"
        ]
      }
    ]
  }
}
