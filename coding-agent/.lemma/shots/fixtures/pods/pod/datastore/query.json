   "items": [
    {
     "id": "1b926ee9-385b-55d7-9cc1-044ce310ae20",
     "question": "Where do we retry failed webhook deliveries, and how many times?",
     "repo": "acme/api",
     "ref": "main",
     "sha": "3f2a9c1e8b7d6a5f4e3d2c1b0a9f8e7d6c5b4a39",
     "conversation_id": "9404283b-d0f4-5575-9e8b-54b59d6fef34",
     "state": "answered",
     "task_id": "ad204975-fe31-508e-a200-38775bd27f4d",
     "asked_by": "user-sample",
     "asked_by_name": "R. P.",
     "answered_at": "2026-11-25T09:30:00+00:00",
     "answer": "We don't. A delivery is sent once from `deliver()` `api/webhooks/deliver.py:42`. A response outside 2xx is written to the delivery log and the event is marked failed `api/webhooks/deliver.py:88`; nothing picks failed events up again.\n\nThe one retry helper in the codebase is `with_backoff()` `api/core/retry.py:12`. Invoice sync uses it `api/billing/sync.py:57`: 5 tries, doubling from 1 s, capped at 60 s.\n\nNot checked: whether the queue worker retries on its own; its settings are outside this repository.",
     "read": [
      {
       "path": "api/webhooks/deliver.py",
       "start": 30,
       "end": 95
      },
      {
       "path": "api/webhooks/log.py",
       "start": 1,
       "end": 60
      },
      {
       "path": "api/core/retry.py",
       "start": 1,
       "end": 40
      },
      {
       "path": "api/billing/sync.py",
       "start": 40,
       "end": 75
      },
      {
       "path": "api/webhooks/test_deliver.py",
       "start": 1,
       "end": 120
      }
     ],
     "created_at": "2026-11-25T09:28:00+00:00",
     "updated_at": "2026-11-25T09:28:00+00:00"
    },
    {
     "id": "8c917e94-c67f-5d7a-b24a-fa9cc2231ddf",
     "question": "Where is the CSV export built?",
     "repo": "acme/web",
     "ref": "main",
     "sha": "8c1d4e7f0a2b3c5d6e8f9a1b2c4d5e7f8a0b1c3d",
     "conversation_id": null,
     "state": "answered",
     "task_id": "2dec01ed-15e6-5d8d-b68e-0a27534aa0bf",
     "asked_by": "user-sample",
     "asked_by_name": "R. P.",
     "answered_at": "2026-11-24T11:00:00+00:00",
     "answer": "In `buildCsv()` `web/reports/export.ts:31`. It asks the API for every row at once through `fetchRows()` `web/reports/export.ts:12`, which calls `GET /reports/{id}/rows` `api/reports/rows.py:58` with no page size, then joins them into one string `web/reports/export.ts:47-52` before the download starts.\n\nThat is why a large report hits the 30-second limit set in `web/server/timeouts.ts:8`.",
     "read": [
      {
       "path": "web/reports/export.ts",
       "start": 1,
       "end": 80
      },
      {
       "path": "api/reports/rows.py",
       "start": 40,
       "end": 90
      },
      {
       "path": "web/server/timeouts.ts",
       "start": 1,
       "end": 20
      }
     ],
     "created_at": "2026-11-24T10:58:00+00:00",
     "updated_at": "2026-11-24T10:58:00+00:00"
    }
   ],
   "total": 2
  }
 },
