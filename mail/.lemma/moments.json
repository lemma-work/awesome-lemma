{
  "//": "The pictures on Mail's page on the website, taken from its Try it demo by `node _kit/bin/moments.mjs mail` into .lemma/moments/. listing.json names them by `name`.",
  "captures": [
    {
      "name": "triage",
      "alt": "Mail's Needs reply list: a conversation opens on its drafted reply, Done is pressed, and the next one opens",
      "loop": true,
      "cursor": true,
      "route": "/needs",
      "viewport": [
        1184,
        700
      ],
      "clip": {
        "x": 0,
        "y": 34,
        "width": 1184,
        "height": 666
      },
      "crf": 25,
      "poster": 3.6,
      "steps": [
        {
          "wait": 900
        },
        {
          "click": ".m-row__open",
          "nth": 0
        },
        {
          "wait": 1300
        },
        {
          "scroll": ".m-readerscroll",
          "to": ".m-compose",
          "ms": 1200
        },
        {
          "wait": 1900
        },
        {
          "click": ".m-readerbar .c-btn",
          "text": "Done"
        },
        {
          "wait": 1800
        }
      ],
      "phone": {
        "viewport": [
          390,
          720
        ],
        "before": [
          {
            "click": ".m-found button[aria-label='Dismiss']"
          },
          {
            "mouse": [
              4,
              4
            ]
          }
        ],
        "clip": {
          "selector": ".m-main",
          "from": ".m-listhead"
        },
        "crf": 24
      },
      "window": "Needs reply"
    },
    {
      "name": "connect",
      "alt": "Mail's first screen: pick Gmail or Outlook, then read the last month",
      "route": "/",
      "viewport": [
        380,
        900
      ],
      "patch": {
        "rows": [
          {
            "match": "from mail_settings",
            "set": {
              "setup_step": "connect",
