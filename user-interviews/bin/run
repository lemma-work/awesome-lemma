#!/bin/bash
# Run one of the bound Lemma's functions and print its output (or its error).
#   bin/run roadmap_rank '{"sort": "open"}'
here="$(cd "$(dirname "$0")" && pwd)"
"$here/lemma" --json functions run "$1" -d "${2:-{\}}" 2>&1 | uv run --no-project python -c "import json,sys
raw=sys.stdin.read()
try: d=json.loads(raw)
except ValueError: print(raw); sys.exit(1)
out=d.get('output_data') or d.get('output')
if d.get('status') in ('FAILED','ERROR') or d.get('error'): print('FAILED', json.dumps(d.get('error') or d, default=str)[:3000]); sys.exit(1)
print(json.dumps(out if out is not None else d, indent=1, default=str, ensure_ascii=False))"
