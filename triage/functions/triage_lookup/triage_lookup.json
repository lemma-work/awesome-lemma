{
  "name": "triage_lookup",
  "description": "What's known about some words (text): the open and recently fixed items that match, each with its number, state, reach and owner, and what the team published as known. Use before filing, or when someone asks whether something is broken.",
  "type": "API",
  "visibility": "POD",
  "code": {
    "$file": "code.py"
  },
  "permissions": {
    "grants": [
      {
        "resource_type": "datastore_table",
        "resource_name": "triage_item",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "triage_report",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "triage_known",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read"
        ]
      }
    ]
  }
}
