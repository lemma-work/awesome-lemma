{
  "name": "triage_tell",
  "description": "Tell the people who asked about an item (item, text), each where they asked: a GitHub comment or a Slack thread reply, once per place. dry_run says who would be told and sends nothing.",
  "type": "API",
  "visibility": "POD",
  "code": {
    "$file": "code.py"
  },
  "permissions": {
    "grants": [
      {
        "resource_type": "datastore_table",
        "resource_name": "triage_settings",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "triage_item",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "ask",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read",
          "datastore.record.write"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "triage_event",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read",
          "datastore.record.write"
        ]
      },
      {
        "resource_type": "connector",
        "resource_name": "github",
        "permission_ids": [
          "connector.use"
        ]
      },
      {
        "resource_type": "connector",
        "resource_name": "slack",
        "permission_ids": [
          "connector.use"
        ]
      }
    ]
  }
}
