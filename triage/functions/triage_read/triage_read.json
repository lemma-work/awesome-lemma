{
  "name": "triage_read",
  "description": "Ask triage_reader for the Lemma's read of one item (item): what it is, what each source answered, what couldn't be checked, the files, a fix hint. Runs on its own from 25 people and for high security alerts.",
  "type": "API",
  "visibility": "POD",
  "code": {
    "$file": "code.py"
  },
  "permissions": {
    "grants": [
      {
        "resource_type": "datastore_table",
        "resource_name": "triage_settings",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "triage_item",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read",
          "datastore.record.write"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "triage_report",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read"
        ]
      },
      {
        "resource_type": "workflow",
        "resource_name": "triage-read",
        "permission_ids": [
          "workflow.read",
          "workflow.execute"
        ]
      }
    ]
  }
}
