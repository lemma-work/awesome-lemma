{
  // GitHub's code_scanning_alert webhook. The app makes one WEBHOOK schedule per event at
  // set-up, as the person, through the Lemma's GitHub connector (GitHub routes
  // by installation; triage_on_github keeps only the watched repositories). GitHub sends this once Triage's GitHub fix (on lemma-platform#1246) is live and each GitHub owner accepts the new permission.
  "name": "triage-github-code-scanning-alert",
  "description": "A code scanning alert opened or reopened becomes a report; fixed or dismissed closes the item.",
  "max_concurrent_runs": 4,
  "start": { "type": "EVENT", "config": {
    "connector_id": "github",
    "connector_trigger_id": "github:http:code_scanning_alert"
  } },
  "nodes": [
    { "id": "read", "type": "FUNCTION", "label": "Read it",
      "config": { "function_name": "triage_on_github", "input_mapping": {
        "event": { "type": "literal", "value": "code_scanning_alert" },
        "payload": { "type": "expression", "value": "start.payload" } } } },
    { "id": "end", "type": "END", "label": "Done" }
  ],
  "edges": [ { "id": "e1", "source": "read", "target": "end" } ]
}
