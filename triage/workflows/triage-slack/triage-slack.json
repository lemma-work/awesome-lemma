{
  // A message in a Slack channel the Lemma's bot is in. The app makes one
  // `triage-slack` schedule (the server allows one per workflow and person)
  // for the workspace; triage_on_slack keeps only the watched channels. Needs
  // the Slack channel trigger (lemma-platform#1245): until it is live the
  // schedule is refused and the 15-minute poll reads the channels instead.
  "name": "triage-slack",
  "description": "A message in a watched Slack channel: a report is filed, a question or chatter is left alone.",
  "max_concurrent_runs": 4,
  "start": { "type": "EVENT", "config": {
    "connector_id": "slack",
    "connector_trigger_id": "slack:http:slack_channel_message"
  } },
  "nodes": [
    { "id": "read", "type": "FUNCTION", "label": "Is it a report?",
      "config": { "function_name": "triage_on_slack", "input_mapping": {
        "payload": { "type": "expression", "value": "start.payload" } } } },
    { "id": "end", "type": "END", "label": "Done" }
  ],
  "edges": [ { "id": "e1", "source": "read", "target": "end" } ]
}
