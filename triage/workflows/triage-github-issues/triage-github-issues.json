{
  // GitHub's issues webhook. The app makes one WEBHOOK schedule per event at
  // set-up, as the person, through the Lemma's GitHub connector (GitHub routes
  // by installation; triage_on_github keeps only the watched repositories).
  "name": "triage-github-issues",
  "description": "An issue opened or reopened on a watched repository becomes a report, its issue form read field by field.",
  "max_concurrent_runs": 4,
  "start": { "type": "EVENT", "config": {
    "connector_id": "github",
    "connector_trigger_id": "github:http:issues"
  } },
  "nodes": [
    { "id": "read", "type": "FUNCTION", "label": "Read it",
      "config": { "function_name": "triage_on_github", "input_mapping": {
        "event": { "type": "literal", "value": "issues" },
        "payload": { "type": "expression", "value": "start.payload" } } } },
    { "id": "end", "type": "END", "label": "Done" }
  ],
  "edges": [ { "id": "e1", "source": "read", "target": "end" } ]
}
