{
  "name": "@lemma-plugins/kit",
  "version": "0.1.0",
  "description": "The one look for every Lemma plugin app: the host's theme tokens, Inter, lucide icons, and the product furniture (tables, record layout, filters, search, skeletons, empty states, drawers).",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./kit.css": "./dist/kit.css"
  },
  "sideEffects": ["*.css"],
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/kit.css dist/kit.css"
  },
  "peerDependencies": {
    "lemma-sdk": ">=0.10.1",
    "lucide-react": ">=0.468.0",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "lemma-sdk": "file:vendor/lemma-sdk-0.10.1.tgz",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
