{
  // One delivery to one of the Lemma's form webhooks (Typeform, Tally,
  // Webflow, Fillout, Google Ads lead forms, Zapier or Make). Each hook is
  // made by the app as a person and writes here; the platform stamps
  // `received_at` and `hook`, the whole body goes to `payload`, and the
  // provider's own id goes to `delivery_id`, unique, so a redelivery is
  // answered "duplicate" and never filed twice. Its trigger is made by the
  // app with include_outside_rows. Needs the webhook address
  // (lemma-platform#1255); until it is live the table stays empty.
  "name": "forms_hooked",
  "primary_key_column": "id",
  "enable_rls": false,
  "visibility": "POD",
  "columns": [
    { "name": "payload", "type": "JSON" },
    { "name": "received_at", "type": "DATETIME" },
    { "name": "hook", "type": "TEXT", "max_length": 64 },
    { "name": "delivery_id", "type": "TEXT", "max_length": 400, "unique": true },
    // Internal: the answer it became.
    { "name": "answer_id", "type": "UUID" }
  ],
  "config": {}
}
