{
  // GitHub's pull_request webhook. Set-up makes one WEBHOOK schedule for it, as the
  // owner, through the Lemma's GitHub connector (GitHub routes by
  // installation, not by repository; deps_on_github keeps only watched ones).
  "name": "deps-on-pull-request",
  "description": "A pull request in a watched repository: keep it when it is one the Lemma opened.",
  "max_concurrent_runs": 4,
  "start": { "type": "EVENT", "config": {
    "connector_id": "github",
    "connector_trigger_id": "github:http:pull_request"
  } },
  "nodes": [
    { "id": "keep", "type": "FUNCTION", "label": "Keep what GitHub says",
      "config": { "function_name": "deps_on_github", "input_mapping": {
        "event": { "type": "literal", "value": "pull_request" },
        "payload": { "type": "expression", "value": "start.payload" } } } },
    { "id": "end", "type": "END", "label": "Done" }
  ],
  "edges": [ { "id": "e1", "source": "keep", "target": "end" } ]
}
