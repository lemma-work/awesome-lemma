 "writeup": {
  "title": "Checkout returned 502 for EU card payments",
  "drafted_at": "2026-11-25T14:48:00+00:00",
  "sections": [
   {
    "key": "summary",
    "heading": "Summary",
    "items": [
     {
      "key": "summary.0",
      "kind": "p",
      "text": "A change merged at 13:58 cut the EU payment provider's timeout from 10 s to 1 s.",
      "cites": [
       "2ea1485d-a610-5110-8393-42e96f153122"
      ]
     },
     {
      "key": "summary.1",
      "kind": "p",
      "text": "The provider takes about 1.4 s to answer, so every EU card payment timed out from the 14:01 deploy until the revert went out at 14:47.",
      "cites": [
       "56725595-022d-5234-8608-4a298e9ed0a6",
       "18b9de89-dc2d-5b87-b58a-e289a9c1cabd",
       "956f384a-cf9b-539a-8a5e-05041a1294f8"
      ]
     },
     {
      "key": "summary.2",
      "kind": "p",
      "text": "Wallets and non-EU cards were not affected.",
      "cites": [
       "a827fb0a-736e-5900-85aa-a451c21a54ae"
      ]
     }
    ]
   },
   {
    "key": "impact",
    "heading": "Impact",
    "items": [
     {
      "key": "impact.0",
      "kind": "p",
      "text": "About 1,240 people saw a failed payment.",
      "cites": [
       "a3353ced-24cf-5374-995e-68f34e43e9f2"
      ]
     },
     {
      "key": "impact.1",
      "kind": "p",
      "text": "Roughly €38,000 of orders were delayed, most of them retried later.",
      "cites": []
     }
    ]
   },
   {
    "key": "why",
    "heading": "Why it happened",
    "items": [
     {
      "key": "why.0",
      "kind": "p",
      "text": "The timeout was lowered to make a slow-provider page fail fast.",
      "cites": [
       "2ea1485d-a610-5110-8393-42e96f153122"
      ]
     },
     {
      "key": "why.1",
      "kind": "p",
      "text": "Nothing tested the EU provider's real response time, and the change was reviewed by someone who did not own payments.",
      "cites": [
       "5e8b8c81-130f-58ee-981c-3a08bf43ed39"
      ]
     }
    ]
   },
   {
    "key": "went",
    "heading": "What went well, what didn't",
    "items": [
     {
      "key": "went.0",
      "kind": "li",
      "text": "Detected within a minute: Triage saw the spike in users before anyone reported it.",
      "cites": [
       "a3353ced-24cf-5374-995e-68f34e43e9f2"
      ]
     },
     {
      "key": "went.1",
      "kind": "li",
      "text": "First update took 12 minutes.",
      "cites": [
       "29988300-a7f7-5c33-a14c-8da0c9e11411"
      ]
     },
     {
      "key": "went.2",
      "kind": "li",
      "text": "The call wasn't recorded, so its decisions are missing here.",
      "cites": []
     }
    ]
   }
  ],
