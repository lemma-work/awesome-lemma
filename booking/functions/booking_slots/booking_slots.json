{
  "name": "booking_slots",
  "description": "Work out the open times on the person's page from their live calendars (Google, Outlook or Meetings' sample), their rules and the bookings already taken, and put them on the page. A calendar that cannot be read leaves the times as they were.",
  "type": "API",
  "visibility": "POD",
  "code": {
    "$file": "code.py"
  },
  "permissions": {
    "grants": [
      {
        "resource_type": "datastore_table",
        "resource_name": "booking_settings",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "booking_page",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read",
          "datastore.record.write"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "meetings_calendar",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "booking_request",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read"
        ]
      },
      {
        "resource_type": "folder",
        "resource_name": "/meetings-sample",
        "permission_ids": [
          "folder.read"
        ]
      },
      {
        "resource_type": "connector",
        "resource_name": "google_calendar",
        "permission_ids": [
          "connector.use"
        ]
      },
      {
        "resource_type": "connector",
        "resource_name": "outlook",
        "permission_ids": [
          "connector.use"
        ]
      }
    ]
  }
}
