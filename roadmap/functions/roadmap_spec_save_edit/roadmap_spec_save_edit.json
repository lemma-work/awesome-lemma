    "grants": [
      {
        "resource_type": "datastore_table",
        "resource_name": "feature",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "feedback",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "roadmap_spec",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read",
          "datastore.record.write"
        ]
      },
      {
        "resource_type": "folder",
        "resource_name": "/pages",
        "permission_ids": [
          "folder.read",
          "folder.write"
        ]
      }
    ]
  }
}
