{
  "name": "roadmap_ship",
  "description": "Mark a roadmap item shipped (shipped_on, default today; undo puts it back in Now). Leaves feature.stage to Release notes, which sets it live and tells the people who asked. Says how many people there are to tell.",
  "type": "API",
  "visibility": "POD",
  "code": {
    "$file": "code.py"
  },
