    "grants": [
      {
        "resource_type": "datastore_table",
        "resource_name": "feature",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "ask",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "roadmap_item",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read",
          "datastore.record.write"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "roadmap_public",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read",
          "datastore.record.write",
          "datastore.record.delete"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "roadmap_settings",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read"
        ]
      },
      {
        "resource_type": "datastore_table",
