{
  "name": "prr_reviewer",
  "description": "Reads one pull request at one commit against the team's rules: a plain summary, the key changes, the lines nobody needs to read, a ledger of every rule in scope (passed, broken, not checked and why) and findings on their lines with the rule each breaks. Reads code; never writes to GitHub, never pushes.",
  "visibility": "POD",
  "instruction": { "$file": "instruction.md" },
  "toolsets": ["WORKSPACE_CLI"],
  "input_schema": {
    "type": "object",
    "properties": {
      "context": { "type": "object", "description": "From prr_begin_round: pr, files, rules, prior_findings, touched, cross_pr, read_only." }
    },
    "required": ["context"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "summary": { "type": "string", "description": "At most two plain sentences: what it does for people, then the one thing to know." },
      "key_changes": { "type": "array", "items": { "type": "object", "properties": {
        "title": { "type": "string" }, "why": { "type": "string" },
        "hunks": { "type": "array", "items": { "type": "object", "properties": {
          "path": { "type": "string" }, "start": { "type": "integer" }, "end": { "type": "integer" } }, "required": ["path"] } }
      }, "required": ["title"] } },
      "mechanical": { "type": "array", "items": { "type": "object", "properties": {
        "kind": { "type": "string", "enum": ["generated", "lockfile", "snapshot", "fixture", "vendored", "docs", "tests", "rename"] },
        "files": { "type": "integer" }, "lines": { "type": "integer" },
        "examples": { "type": "array", "items": { "type": "string" } }
      }, "required": ["kind", "files", "lines"] } },
      "ledger": { "type": "array", "description": "Exactly one entry per rule in context.rules.", "items": { "type": "object", "properties": {
        "rule_id": { "type": "string" },
        "state": { "type": "string", "enum": ["passed", "broken", "not_checked"] },
        "note": { "type": "string" }
      }, "required": ["rule_id", "state"] } },
      "findings": { "type": "array", "items": { "type": "object", "properties": {
        "fingerprint": { "type": "string" },
        "rule_id": { "type": "string" },
        "severity": { "type": "string", "enum": ["must_fix", "should_fix", "nit"] },
        "path": { "type": "string" }, "line": { "type": "integer" }, "end_line": { "type": "integer" },
        "title": { "type": "string" }, "body": { "type": "string" }, "suggestion": { "type": "string" }
      }, "required": ["fingerprint", "severity", "title", "body"] } },
      "resolved": { "type": "array", "items": { "type": "string" }, "description": "Fingerprints of earlier open findings gone at this commit." },
      "risk_up": { "type": "object", "properties": {
        "risk": { "type": "string", "enum": ["medium", "high"] }, "reason": { "type": "string" } }, "required": ["risk", "reason"] },
      "lines_total": { "type": "integer" },
      "lines_to_read": { "type": "array", "items": { "type": "object", "properties": {
        "path": { "type": "string" }, "start": { "type": "integer" }, "end": { "type": "integer" } }, "required": ["path"] } }
    },
    "required": ["summary", "key_changes", "mechanical", "ledger", "findings", "resolved"]
  },
  "permissions": { "grants": [
    { "resource_type": "connector", "resource_name": "github", "permission_ids": ["connector.use"] }
  ] }
}
