#!/bin/bash
# Put this folder's code for some functions into the bound Lemma, in place:
# a server-side install never updates a function the Lemma already has.
#   bin/push user_feedback_read user_feedback_file
here="$(cd "$(dirname "$0")/.." && pwd)"
for name in "$@"; do
  payload="$(uv run --no-project python -c "import json,sys; print(json.dumps({'code': open(sys.argv[1]).read()}))" "$here/functions/$name/code.py")"
  "$here/bin/lemma" --json functions update "$name" -d "$payload" >/dev/null && echo "pushed $name" || echo "FAILED $name"
done
